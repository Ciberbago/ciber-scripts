# Maintainer: Ciberbago

pkgname=grab
pkgver=3.8.0
pkgrel=1
pkgdesc="A download manager designed for GNOME using GTK4 + libadwaita"
arch=('x86_64')
url="https://github.com/houssemko/Grab"
license=('MIT')
depends=('glibc'
         'gcc-libs'
         'gtk4'
         'libadwaita'
         'hicolor-icon-theme'
         'yt-dlp')
makedepends=('rust' 'cargo')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/houssemko/Grab/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "Grab-${pkgver}"
    cargo fetch --locked --target "$CHOST"
}

build() {
    cd "Grab-${pkgver}"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    
    # Limpiar flags C/C++ que interfieren con crates C embebidos
    unset CFLAGS
    unset CXXFLAGS
    unset LDFLAGS
    
    # Solo compilamos el binario de release (--bin grab en vez de --all-targets)
    cargo build --frozen --release --bin grab
}

package() {
    cd "Grab-${pkgver}"
    
    # Instalar binario principal
    install -Dm755 "target/release/grab" "${pkgdir}/usr/bin/grab"

    # Licencia
    install -Dm644 LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}"

    # Entrada de escritorio para GNOME Activities
    install -Dm644 /dev/stdin "${pkgdir}/usr/share/applications/${pkgname}.desktop" <<EOF
[Desktop Entry]
Name=Grab
Comment=A download manager designed for GNOME
Exec=grab
Icon=download
Terminal=false
Type=Application
Categories=Network;FileTransfer;
StartupNotify=true
EOF
}
