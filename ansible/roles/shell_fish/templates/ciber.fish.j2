{% for a in fish_aliases %}
alias {{ a.name }} '{{ a.body | replace("'", "\\'") }}'
{% endfor %}

{% for f in fish_functions %}
function {{ f.name }}
{{ f.body | trim | indent(4, first=True) }}
end

{% endfor %}
