#!/usr/bin/env bash
# Aplica la configuracion de la sesion de GNOME (dconf, extensiones, firefox).
#
# Requiere estar dentro de GNOME: dconf y gsettings hablan por DBus con la
# sesion del usuario, asi que esto no funciona por SSH ni desde una TTY.
#
#   ciber-session                    todo
#   ciber-session --check --diff     simulacro
#   ciber-session --tags gnome       solo GNOME, sin tocar el perfil de Firefox
#
# Rama fijada cuando se genero este archivo: {{ ciber_branch }}
#
# Ver ciber-apply para por que no se usa ansible-pull.
#
# Generado por Ansible. No editar a mano: se sobrescribe en cada run.
set -euo pipefail

REPO="{{ ciber_git_repo }}"
RAMA="{{ ciber_branch }}"
DEST="{{ ciber_checkout_dir }}"
LOGFILE="$HOME/ciber.log"

export ANSIBLE_CONFIG="${DEST}/ansible/ansible.cfg"
export PYTHONUNBUFFERED=1
export ANSIBLE_FORCE_COLOR=1

echo "==> Actualizando ${DEST} (rama ${RAMA})"
if [[ -d "${DEST}/.git" ]]; then
    git -C "$DEST" fetch --prune origin
    git -C "$DEST" checkout -qf -B "$RAMA" "origin/${RAMA}"
else
    git clone --branch "$RAMA" "$REPO" "$DEST"
fi
cd "$DEST"

CMD="ansible-playbook -i ansible/inventory.ini --ask-become-pass"
CMD+=" --extra-vars 'ciber_branch=${RAMA}'"
CMD+=" ansible/session.yml"
for arg in "$@"; do
    CMD+=" $(printf '%q' "$arg")"
done

if command -v script &>/dev/null; then
    script -q -a -e -c "$CMD" "$LOGFILE"
else
    eval "$CMD"
fi
