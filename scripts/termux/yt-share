#!/data/data/com.termux/files/usr/bin/bash
#
# yt-share - descarga lo que compartes a Termux.
#
# La ruta absoluta del shebang no es decorativa. En Android no existe
# /usr/bin/env, asi que '#!/usr/bin/env bash' solo funciona si quien ejecuta el
# script lo arregla por su cuenta. Cuando Android lanza este script por el
# intent de compartir, no lo hace: lee la primera linea, ve que empieza por
# /usr, y ejecuta su propio env con el script como argumento. Ese env intenta
# lanzarlo, el kernel lee otra vez el shebang, busca /usr/bin/env, no lo
# encuentra y muere con codigo 127. El detalle esta en setupShellCommandArguments
# de TermuxShellUtils.java.
#
# El resto de scripts de este directorio usan '#!/usr/bin/env bash' y funcionan
# porque se ejecutan desde una shell de Termux, que si sabe resolverlos. Este se
# ejecuta desde otro sitio, y por eso se escribe distinto.
#
# Android llama a ~/bin/termux-url-opener con la URL compartida y ese archivo
# es un shim que acaba aqui. Lo lanza en una terminal NUEVA (ShellCreateMode
# ALWAYS, en TermuxService.actionServiceExecute), que es la que se ve al
# compartir: no hay nadie a quien preguntar, asi que no hay menu, y el formato
# es el de por defecto.
#
# Salida en dos sitios, siempre: un log en
# ${XDG_STATE_HOME:-$HOME/.local/state}/yt-share/ultimo.log, que se sobrescribe
# en cada corrida, y si existe la app Termux:API una notificacion. Sin
# Termux:API el script funciona igual, solo que en silencio: compartir links
# NO necesita esa app, solo el aviso es opcional.
#
# Lo que se ve va al log porque el log puede llevar dentro la linea de comando
# completa, y esa puede llevar cookies. Por eso el directorio va a 700 y el
# log a 600.

set -u

# Se sube con cada cambio del propio script. Se imprime al arrancar porque al
# compartir la sesion puede quedarse en negro, y entonces la unica forma de
# saber que copia esta corriendo es leerla en pantalla.
VERSION="2026.10.09-1"

# El mismo archivo que usa yt-tui: las cookies que pongas ahi valen para los
# dos. Se carga mas abajo, DESPUES de los valores por defecto, para que lo que
# haya en el archivo se imponga sobre ellos.
CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/yt-tui/config"

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/yt-share"
LOG_FILE="$STATE_DIR/ultimo.log"
LOCK_DIR="$STATE_DIR/bloqueado"

# Android mata los procesos en segundo plano que parece que no hacen nada.
# El wakelock se pide solo si el comando existe y se suelta al salir.
WAKELOCK_TAKEN=0
LOCK_TAKEN=0

# Mismo destino que yt-tui pero en su propia carpeta: lo que baja el boton de
# compartir no se mezcla con lo que descargas a mano.
DEFAULT_DOWNLOAD_DIR="$HOME/storage/downloads/yt-share"
# Si Android no concedio el almacenamiento, ~/storage no existe. Es preferible
# bajar en la carpeta interna de Termux que no bajar nada.
FALLBACK_DOWNLOAD_DIR="$HOME/downloads/yt-share"
DOWNLOAD_DIR="$DEFAULT_DOWNLOAD_DIR"
DIR_IS_DEFAULT=1

# El mismo formato que yt-tui llama "Mejor disponible".
FORMAT_ARGS=(--format 'bestvideo*+bestaudio/best' --merge-output-format mp4)
NO_PLAYLIST=1
YTDLP_EXTRA_ARGS=()
JS_RUNTIME=""
DRY_RUN=0
TYPE="video"

NOTIFY_ID="yt-share"
# Si se ha dibujado una linea de progreso, hay que cerrarla con un salto antes
# de escribir el resultado, o el mensaje final sale pegado encima.
PROGRESS_DRAWN=0
# Segundos entre actualizaciones de la notificacion de progreso. Sin tope, una
# descarga rapida manda cientos de avisos y la API se atasca.
PROGRESS_INTERVAL=3

# Al compartir, Termux ejecuta este script en una terminal NUEVA, que es la que
# se ve al compartir y se quedaba en negro hasta que el script acababa.
#
# Donde se dibuja, en este orden:
#   1. stdout, si es una terminal. Es lo normal.
#   2. /dev/tty, si stdout NO es terminal pero /dev/tty si lo es. Cubre el caso
#      en que la sesion de Termux redirecciona stdout: ahi -t 1 daria falso y
#      sin este respaldo la pantalla se quedaria en negro igual, que es
#      justamente lo que paso.
#   3. nada. Sin terminal de ningun tipo (redireccion a fichero, cron, otro
#      script): no se dibuja nada, porque los caracteres de control serian
#      ruido en un fichero.
TTY=0
SCREEN_FD=1
if [[ -t 1 ]]; then
    TTY=1
elif [[ -c /dev/tty ]]; then
    # El exec va dentro de un bloque con su propia redireccion de error. Fuera de
    # ella, bash avisa igualmente aunque el 2>/dev/tty este puesto, y ese aviso
    # sale justo en la salida que se quiere limpia.
    if { exec 3>/dev/tty; } 2>/dev/null; then
        # stdout no es terminal pero /dev/tty si. Se dibuja ahi.
        TTY=1
        SCREEN_FD=3
    fi
fi

# El color y el redibujo son cosas distintas. NO_COLOR apaga el color, pero no
# el retorno de carro: sin el, cada avance del progreso se quedaria en su
# propia linea y la pantalla se llenaria de scroll. El unico caso en que no se
# redibuja es cuando stdout no es una terminal.
if ((TTY)) && command -v tput >/dev/null 2>&1; then
    CR=$(tput cr 2>/dev/null || printf '\r')
    EL=$(tput el 2>/dev/null || printf '\033[K')
else
    CR=""; EL=""
fi

# Colores: solo si hay terminal y NO_COLOR no esta puesto. Es el bloque que
# tienen todos los scripts del directorio. Va aparte del anterior a proposito:
# se incumplieron al meterlos juntos y se desincronizaron, uno acababa
# definiendo GRIS y el otro no, y con set -u eso tumba el script entero.
if ((TTY)) && [[ -z "${NO_COLOR:-}" ]] && command -v tput >/dev/null 2>&1; then
    B=$(tput bold 2>/dev/null || true)
    R=$(tput sgr0 2>/dev/null || true)
    VERDE=$(tput setaf 2 2>/dev/null || true)
    AMAR=$(tput setaf 3 2>/dev/null || true)
    ROJO=$(tput setaf 1 2>/dev/null || true)
    CIAN=$(tput setaf 6 2>/dev/null || true)
    GRIS=$(tput setaf 8 2>/dev/null || true)
else
    B=""; R=""; VERDE=""; AMAR=""; ROJO=""; CIAN=""; GRIS=""
fi

# ---------------------------------------------------------------------------
# Log y avisos
# ---------------------------------------------------------------------------

log_line() {
    printf '%s\n' "$1" >>"$LOG_FILE" 2>/dev/null || true
}

log_rule() {
    log_line '------------------------------------------------------------'
}

log_command() {
    log_line "$1"
    # La version va en el log por lo mismo que va en pantalla: si la sesion de
    # compartir se queda en negro, el log es lo unico que queda para saber que
    # copia corrio y si fallo antes de escribir nada.
    log_line "yt-share $VERSION"
    log_line "Pantalla: $( ((TTY)) && echo 'si' || echo 'no')  (terminal: ${SCREEN_FD})"
    log_line "URL: $URL"
    log_line "Destino: $DOWNLOAD_DIR"
    log_line "Comando: ${CMD[*]}"
    log_rule
}

# ---------------------------------------------------------------------------
# Media scanner
# ---------------------------------------------------------------------------

# Sin esto el archivo queda en disco pero no aparece en la galeria: escribirlo
# no le dice nada al MediaStore, que es el indice que lee Android para mostrar
# fotos y videos.
#
# No hay UNA via que_valga en todos los Android, asi que se prueban varias y se
# anota cual llego a lanzarse. Y ADEMAS se comprueba si el archivo acabo en el
# MediaStore, porque sin esa comprobacion no hay manera de saber si funciono:
#
#   - termux-media-scan sale con 0 SIEMPRE. Su callback en Java solo escribe en
#     el log interno de Android y no lo devuelve, y la wiki del propio Termux
#     dice que su salida es un "informational message". Antes este script
#     decia "Escaneado para la galeria" solo porque el comando no fallaba, y
#     eso es mentira: no fallo ni cuando no indexaba nada.
#   - content call y el broadcast dependen de la version de Android y de los
#     permisos del usuario.
#
# El orden va de la mas especifica a la mas general, y al final se pregunta al
# MediaStore si el archivo esta ahi. Esa respuesta es la unica fiable.
#
# Detalle que importa en todas: hay que darle la ruta REAL y no la del
# simbolico. ~/storage/shared es un enlace a /storage/emulated/0 y si se le pasa
# el enlace no lo reconoce.
scan_media() {
    local path="$1"
    [[ -e "$path" ]] || return 1

    local real
    real=$(realpath "$path" 2>/dev/null) || return 1
    [[ -e "$real" ]] || return 1

    log_line "Media: destino $real"

    # 1. Termux:API. Es la via "de verdad" pero necesita el APK aparte.
    if command -v termux-media-scan >/dev/null 2>&1; then
        log_line 'Media: se lanza termux-media-scan (Termux:API)'
        api termux-media-scan "$real"
        if media_in_store "$real"; then
            log_line 'Media: ya esta en el MediaStore.'
            return 0
        fi
    else
        log_line 'Media: no hay termux-media-scan, se continua con las otras vias.'
    fi

    # 2. El call de MediaStore que el propio Android expone. ContentScannerAPI
    #    define SCAN_FILE_CALL y SCAN_VOLUME_CALL, y asi se pueden pedir:
    #    content call --uri content://media --method scan_file --arg RUTA
    #    En Android 9 y anteriores esto da UnsupportedOperationException, y en
    #    algunos Android 10+ lo deniega como usuario normal.
    if media_content_cmd; then
        log_line 'Media: se lanza content call --method scan_file'
        "$CONTENT_CMD" call --uri content://media --method scan_file --arg "$real" \
            >/dev/null 2>&1 || true
        sleep 1
        if media_in_store "$real"; then
            log_line 'Media: ya esta en el MediaStore (content call).'
            return 0
        fi
    else
        # Se dice explicitamente, porque si no el "no indexado" final parece
        # un fallo del escaneo cuando en realidad no habia con que escanear.
        log_line 'Media: no hay comando content ni en el PATH ni en /system/bin.'
    fi

    # 3. El broadcast clasico. En theory dejo de hacer efecto en Android 10,
    #    pero hay informes de que sigue funcionando en 10, 11 y 15.
    if command -v am >/dev/null 2>&1; then
        log_line 'Media: se lanza broadcast MEDIA_SCANNER_SCAN_FILE'
        api am broadcast -a android.intent.action.MEDIA_SCANNER_SCAN_FILE \
            --user 0 --receiver-include-background -d "file://$real"
        sleep 1
        if media_in_store "$real"; then
            log_line 'Media: ya esta en el MediaStore (broadcast).'
            return 0
        fi
    fi

    log_line "AVISO: el archivo NO aparece en el MediaStore. Ninguna via lo indexo. Como va el:"
    log_line "  - el log de arriba dice que se llego a lanzar el escaneo"
    log_line "  - si no lo dice, en este Android no hay forma de dispararlo desde Termux"
    log_line "  - se indexa solo al reiniciar el movil, o forzando con:"
    log_line "    content call --uri content://media --method scan_volume --arg external_primary"
    return 1
}

# El comando 'content' no viene en Termux, pero si en /system/bin.
media_content_cmd() {
    if command -v content >/dev/null 2>&1; then
        CONTENT_CMD="$(command -v content)"
        return 0
    fi
    if [[ -x /system/bin/content ]]; then
        CONTENT_CMD="/system/bin/content"
        return 0
    fi
    return 1
}

# La unica comprobacion que vale: preguntar al MediaStore si lo tiene. Se
# busca por nombre de archivo, que es lo unico que se sabe seguro, y con un
# limite de filas porque en un movil con mil fotos la consulta sin WHERE puede
# ser enorme.
media_in_store() {
    local path="$1" base
    base="${path##*/}"
    # Las comillas y el % romperian el WHERE. Los archivos de yt-dlp no los
    # traen, pero un nombre a mano si.
    base="${base//\'/}"
    base="${base//\%/}"
    [[ -n "$base" ]] || return 1

    media_content_cmd || return 1

    "$CONTENT_CMD" query --uri content://media/external/file \
        --projection _display_name --where "_display_name LIKE '%$base%'" \
        2>/dev/null | grep -qF "$base"
}

# Todo lo que viene de la app Termux:API va por aqui. NADA de eso puede
# colgarse, y si se cuelga no puede tumbar la descarga: estos comandos hacen un
# broadcast a otra app y esperan su respuesta, y si esa app no esta, esta
# ocupada o tiene la notificacion bloqueada, se quedan esperando.
#
# Pasaba de verdad: con termux-notification colgado, el script se quedaba
# parado en el aviso inicial y no escribia nada mas, o sea, pantalla negra.
# Por eso el rotulo de arranque va ANTES de la primera llamada, y todo lo
# demas tiene este limite de tiempo.
# Tres segundos. Con diez, una API colgada hacia la descarga esperar 40
# segundos en cuatro timeouts, y el usuario ve la pantalla quieta sin saber si
# esta trabajando. Tres es de sobra para una llamada local por broadcast, y si
# no ha contestado en tres segundos no va a contestar.
#
# El rotulo de progreso de la pantalla es lo que de verdad informa: no depende
# de la API y por eso va antes. La notificacion es el extra, no el aviso.
API_TIMEOUT="${YT_SHARE_API_TIMEOUT:-3}"

api() {
    if command -v timeout >/dev/null 2>&1; then
        timeout "$API_TIMEOUT" "$@" >/dev/null 2>&1 || true
        return 0
    fi
    "$@" >/dev/null 2>&1 || true
    return 0
}

# Notificacion si hay Termux:API. Si no hay no es un error.
notify() {
    local title="$1" content="$2" ongoing="${3:-}"
    command -v termux-notification >/dev/null 2>&1 || return 0
    local args=(--id "$NOTIFY_ID" --title "$title" --content "$content" --alert-once)
    [[ -n "$ongoing" ]] && args+=(--ongoing)
    api termux-notification "${args[@]}"
}

notify_error() {
    local title="$1" content="$2"
    if command -v termux-notification >/dev/null 2>&1; then
        api termux-notification --id "$NOTIFY_ID" --title "$title" --content "$content" --priority high
    elif command -v termux-toast >/dev/null 2>&1; then
        api termux-toast "$title: $content"
    fi
}

# Sin a quien preguntar, los errores graves se dicen tambien por notificacion:
# si el script falla en silencio parece que no pasa nada, y el enlace
# compartido se pierde.
die() {
    log_line "ERROR: $1"
    notify_error 'yt-share' "$1"
    printf '%sError: %s%s\n' "$ROJO" "$1" "$R" >&2
    exit 1
}

# ---------------------------------------------------------------------------
# Dependencias
# ---------------------------------------------------------------------------

select_js_runtime() {
    if command -v deno >/dev/null 2>&1; then
        JS_RUNTIME=deno
    elif command -v node >/dev/null 2>&1; then
        JS_RUNTIME=node
    else
        return 1
    fi
}

# A diferencia de yt-tui, aqui NO se instala nada. En un proceso en segundo
# plano una pregunta de pkg se queda esperando a un teclado que no existe. Se
# avisa de lo que falta y con que comando se arregla.
check_dependencies() {
    local missing=()

    command -v yt-dlp >/dev/null 2>&1 || missing+=("falta yt-dlp: pkg install python-yt-dlp")
    if [[ "$TYPE" != audio ]] && ! command -v ffmpeg >/dev/null 2>&1; then
        missing+=("falta ffmpeg: pkg install ffmpeg")
    fi
    select_js_runtime || missing+=("falta el runtime de JavaScript: pkg install deno")

    ((${#missing[@]} == 0)) && return 0

    die "No se puede descargar: ${missing[*]}"
}

# ---------------------------------------------------------------------------
# Destino
# ---------------------------------------------------------------------------

ensure_destination() {
    mkdir -p "$DOWNLOAD_DIR" 2>/dev/null && return 0

    # Solo tiene sentido caer a la carpeta interna si el destino no lo eligio
    # el usuario. Si viene de ~/.config/yt-tui/config, hay que fallar.
    if ((DIR_IS_DEFAULT)) && mkdir -p "$FALLBACK_DOWNLOAD_DIR" 2>/dev/null; then
        log_line "AVISO: sin acceso al almacenamiento de Android, destino $FALLBACK_DOWNLOAD_DIR"
        DOWNLOAD_DIR="$FALLBACK_DOWNLOAD_DIR"
        return 0
    fi

    die "No se pudo crear la carpeta de destino: $DOWNLOAD_DIR"
}

# ---------------------------------------------------------------------------
# La descarga
# ---------------------------------------------------------------------------

build_command() {
    # Los marcadores CIBER van delante de cada linea que este script tiene que
    # parsear. Son propios, asi que no colisionan con los [download] de yt-dlp.
    #
    # --print implica --quiet en yt-dlp, y --quiet apagaria el progreso salvo
    # que se le pida --progress explicitamente. --newline hace que cada
    # actualizacion de progreso salga en una linea propia, que es lo unico que
    # se puede leer linea a linea.
    CMD=(yt-dlp
        --newline
        --progress
        --progress-template 'download:CIBERPROG|%(progress._percent_str)s|%(progress._speed_str)s|%(progress._eta_str)s'
        --print 'before_dl:CIBERTITLE:%(title).70s'
        --print 'after_move:CIBERFILE:%(filepath)s'
        --no-overwrites
        --output "$DOWNLOAD_DIR/%(title).180s [%(id)s].%(ext)s")

    ((NO_PLAYLIST)) && CMD+=(--no-playlist)
    [[ -n "$JS_RUNTIME" ]] && CMD+=(--js-runtimes "$JS_RUNTIME")
    ((DRY_RUN)) && CMD+=(--simulate)

    if [[ "$TYPE" == audio ]]; then
        CMD+=(-x --audio-format mp3 --audio-quality 192K --embed-metadata)
    else
        CMD+=("${FORMAT_ARGS[@]}")
    fi

    # Los argumentos del usuario van al final a proposito: si pone un --format
    # en ~/.config/yt-tui/config, el ultimo gana y es el suyo.
    CMD+=("${YTDLP_EXTRA_ARGS[@]}" "$URL")
}

# Dibuja la linea de progreso en la pantalla, sobreescribiendola. Una sola
# linea que se va actualizando: si se imprimiese una linea por actualizacion,
# una descarga rapida llenaria la pantalla de scroll inútil.
draw_progress() {
    ((TTY)) || return 0
    local percent="$1" speed="$2" eta="$3"

    local bar=''
    if [[ "$percent" =~ ^([0-9]+) ]]; then
        local done_pct="${BASH_REMATCH[1]}"
        ((done_pct > 100)) && done_pct=100
        local cells=$((done_pct * 20 / 100))
        local i filled
        for ((i = 0; i < 20; i++)); do
            ((i < cells)) && filled='█' || filled='░'
            bar+="$filled"
        done
    fi

    # SIN salto de linea final: el retorno de carro es lo que deja la linea
    # siempre en el mismo sitio. Si cada actualizacion terminase con \n, se
    # acumularian lineas y la pantalla se llenaria de scroll, que es justo lo
    # que se quiere evitar. El salto se pone una vez, al terminar.
    printf '%s%s%s %s %s%s ETA %s%s' \
        "$CR" "$EL" "${CIAN}" "$percent" "$bar" "$speed" "$eta" "${R}" >&"$SCREEN_FD"
    PROGRESS_DRAWN=1
}

# Cierra la linea de progreso para que el mensaje final no acabe pegado encima.
end_progress() {
    ((TTY && PROGRESS_DRAWN)) || return 0
    printf '\n' >&"$SCREEN_FD"
    PROGRESS_DRAWN=0
}

handle_progress() {
    local percent="${1:-}" speed="${2:-}" eta="${3:-}"
    [[ -n "$percent" ]] || return 0

    # La pantalla va mas fino que la notificacion: se redibuja cada vez que
    # hay dato, porque es local y no satura ninguna API.
    draw_progress "$percent" "$speed" "$eta"

    local now
    now=$(date +%s)
    ((now - LAST_NOTIFY >= PROGRESS_INTERVAL)) || return 0
    LAST_NOTIFY=$now

    notify "${TITLE:-Descargando}" "$percent · $speed · ETA $eta" 'ongoing'
}

handle_yt_output() {
    local line="$1"

    case "$line" in
        CIBERPROG\|*)
            local rest="${line#CIBERPROG|}"
            local percent speed eta
            IFS='|' read -r percent speed eta <<<"$rest"
            handle_progress "$percent" "$speed" "$eta"
            return 0
            ;;
        CIBERTITLE:*)
            TITLE="${line#CIBERTITLE:}"
            # En la pantalla del intent esta linea es lo primero que se ve:
            # sin ella la pantalla queda en negro hasta el progreso.
            ((TTY)) && printf '\n%s%s%s\n' "$B" "$TITLE" "$R" >&"$SCREEN_FD"
            ((TTY)) && printf 'Guardando en %s\n\n' "$DOWNLOAD_DIR" >&"$SCREEN_FD"
            notify "$TITLE" 'Descargando...' 'ongoing'
            return 0
            ;;
        CIBERFILE:*)
            FINAL_FILE="${line#CIBERFILE:}"
            return 0
            ;;
    esac

    log_line "$line"
}

# Traduce el fallo a algo accionable. Sin esto el unico sintoma es "no se
# descargo", que no dice nada de por que.
diagnose_failure() {
    local hints=()

    if grep -Eiq '429|too many requests|rate.?limit|temporarily blocked' "$LOG_FILE"; then
        hints+=("El sitio esta limitando las peticiones. Cookies en $CONFIG_FILE")
    fi
    # Antes que lo de iniciar sesion: un video privado no se arregla con
    # cookies, y mandar auki a iniciar sesion solo confunde.
    if grep -Eiq 'private video|members-only|join this channel|not available in your country' "$LOG_FILE"; then
        hints+=("El video es privado, es de miembros o no esta disponible aqui")
    fi
    if grep -Eiq 'sign in|login required|authentication|cookies|confirm you.re human|not a bot' "$LOG_FILE"; then
        hints+=("Pide iniciar sesion o pasar el captcha. Cookies en $CONFIG_FILE")
    fi
    if grep -Eiq 'javascript runtime|js challenge|unable to extract' "$LOG_FILE"; then
        hints+=("Problema con el runtime de JavaScript. Mira: command -v deno")
    fi
    if grep -Eiq 'unable to download webpage|HTTP Error 403|Failed to resolve' "$LOG_FILE"; then
        hints+=("YouTube ha cortado la peticion. Suele ser cookies, o un yt-dlp viejo")
    fi

    ((${#hints[@]} > 0)) || hints+=("Revisa el log: $LOG_FILE")

    local hint
    for hint in "${hints[@]}"; do
        log_line "  - $hint"
    done
    HINT="${hints[0]}"
}

run_download() {
    local status

    log_rule
    log_command 'yt-share'
    log_rule

    # Un coproc para leer linea a linea y conservar a la vez el codigo de
    # salida: un pipe a while lo pierde, porque el while corre en un subshell.
    # 2>&1 mete los mensajes de yt-dlp en el mismo flujo; llegan mezclados con
    # el progreso y se separan por los marcadores.
    local ytdlp_pid
    coproc YTDL { "${CMD[@]}" 2>&1; }
    ytdlp_pid="$YTDL_PID"

    local line
    while IFS= read -r line; do
        handle_yt_output "$line"
    done <&"${YTDL[0]}"

    wait "$ytdlp_pid"
    status=$?
    return "$status"
}

# ---------------------------------------------------------------------------
# Bloqueo y wakelock
# ---------------------------------------------------------------------------

# mkdir es atomico: el que lo crea, lo tiene. Asi dos "compartir" seguidos no
# solapan descargas ni se pisan las notificaciones.
write_lock_pid() {
    # PID primero, porque es lo que se comprueba con kill -0. El segundo campo
    # es cuando empezo, para que se pueda leer a ojo un bloqueo puzzling.
    printf '%s:%s\n' "$$" "$NOW_START" >"$LOCK_DIR/pid" 2>/dev/null || true
}

acquire_lock() {
    if mkdir "$LOCK_DIR" 2>/dev/null; then
        write_lock_pid
        LOCK_TAKEN=1
        return 0
    fi

    # Un bloqueo puede quedarse puesto de una corrida que murio. Y no solo si
    # se agoto la hora: si Android mata el proceso (pantalla apagada, el
    # sistema mata la app), el trap no llega a ejecutarse y el bloqueo se
    # queda ahi, sin proceso detras. Comprobando el PID se ve al instante, sin
    # tener que esperar.
    local lock_pid lock_start lock_age
    lock_pid=$(cut -d: -f1 "$LOCK_DIR/pid" 2>/dev/null || true)
    lock_start=$(cut -d: -f2 "$LOCK_DIR/pid" 2>/dev/null || true)

    if [[ -z "$lock_pid" ]] || ! kill -0 "$lock_pid" 2>/dev/null; then
        # No hay nadie detras del bloqueo. Se retira, sea viejo o no.
        lock_age=$(( $(date +%s) - $(stat -c %Y "$LOCK_DIR" 2>/dev/null || echo 0) ))
        rm -rf "$LOCK_DIR" 2>/dev/null || true
        mkdir "$LOCK_DIR" 2>/dev/null || die "No se pudo tomar el bloqueo en $STATE_DIR"
        write_lock_pid
        LOCK_TAKEN=1
        log_line "AVISO: habia un bloqueo sin proceso vivo (${lock_age}s), se ha retirado."
        return 0
    fi

    die "Ya hay una descarga en marcha. Espera a que termine antes de compartir otro enlace."
}

release_lock() {
    ((LOCK_TAKEN)) || return 0
    rm -rf "$LOCK_DIR" 2>/dev/null || true
    LOCK_TAKEN=0
}

take_wakelock() {
    if command -v termux-wake-lock >/dev/null 2>&1 && api termux-wake-lock; then
        WAKELOCK_TAKEN=1
    fi
}

release_wakelock() {
    if ((WAKELOCK_TAKEN)) && command -v termux-wake-unlock >/dev/null 2>&1; then
        api termux-wake-unlock
    fi
}

cleanup() {
    release_lock
    release_wakelock
}

# ---------------------------------------------------------------------------
# URL
# ---------------------------------------------------------------------------

# Android pasa la URL entera como un solo argumento. Hay apps que comparten
# texto con la URL dentro y otras palabras alrededor, asi que se saca la
# primera que aparezca por si acaso.
extract_url() {
    local raw="$1" found

    if [[ "$raw" =~ ^https?://[^[:space:]]+$ || "$raw" =~ ^magnet:\? ]]; then
        printf '%s' "$raw"
        return 0
    fi

    found=$(printf '%s' "$raw" | grep -oE '(https?://[^[:space:]]+|magnet:\?[^[:space:]]+)' | head -n 1)
    [[ -n "$found" ]] || return 1
    printf '%s' "$found"
}

# ---------------------------------------------------------------------------
# Uso
# ---------------------------------------------------------------------------

usage() {
    printf '%s\n' \
        'Uso: yt-share [opción] URL' \
        '' \
        'Descarga el enlace que compartes a Termux. Sin URL, explica el flujo.' \
        '' \
        'Opciones:' \
        '  --audio      Solo el audio, en MP3 a 192 kbps' \
        '  --max N      Tope de altura en píxeles, por ejemplo --max 1080' \
        '  --dir RUTA   Carpeta de destino. Por defecto ~/storage/downloads/yt-share' \
        '  --dry-run    Lo comprueba todo y no descarga nada' \
        '  --version    La version de este script, sin hacer nada' \
        '  --help       Esta ayuda' \
        '' \
        'El flujo de compartir es este: en YouTube, compartir, elegir Termux.' \
        'No hay menu, porque Android lo lanza sin quien pueda contestar:' \
        'se descarga el mejor formato disponible sin preguntar nada.' \
        'Para elegir calidad, usa yt-tui a mano.' \
        '' \
        'Si esta Termux:API instalada avisa con una notificacion al empezar, cada' \
        'pocos segundos con el progreso, y al terminar. Sin ella funciona igual,' \
        'solo que en silencio. El log de la ultima corrida esta en:' \
        "  $LOG_FILE"
}

# ---------------------------------------------------------------------------

main() {
    local url_arg=""

    while (($# > 0)); do
        case "$1" in
            --audio) TYPE=audio; shift ;;
            --max)
                [[ -n "${2:-}" ]] || die '--max necesita un número.'
                FORMAT_ARGS=(--format "bv*[height<=$2]+ba/b[height<=$2]" --merge-output-format mp4)
                shift 2
                ;;
            --dir)
                [[ -n "${2:-}" ]] || die '--dir necesita una ruta.'
                DOWNLOAD_DIR="$2"
                DIR_IS_DEFAULT=0
                shift 2
                ;;
            --dry-run) DRY_RUN=1; shift ;;
            --version|-V) printf 'yt-share %s\n' "$VERSION"; exit 0 ;;
            --help|-h) usage; exit 0 ;;
            -*) die "Opción desconocida: $1" ;;
            *) url_arg="$1"; shift ;;
        esac
    done

    # Deliberadamente aqui y no arriba: lo que haya en este archivo tiene que
    # ganarle a los valores por defecto de este script.
    if [[ -f "$CONFIG_FILE" ]]; then
        # shellcheck disable=SC1090
        source "$CONFIG_FILE"
    fi

    # Si la config movio el destino, deja de ser un destino "de fabrica" y hay
    # que fallar si no se puede crear, en vez de caer a la carpeta interna.
    [[ "$DOWNLOAD_DIR" == "$DEFAULT_DOWNLOAD_DIR" ]] || DIR_IS_DEFAULT=0

    NOW_START=$(date +%s)
    LAST_NOTIFY=0
    TITLE=''
    FINAL_FILE=''
    HINT=''
    SCANNED=0

    # 700 y 600 porque el log lleva la linea de comando entera, y esa puede
    # llevar cookies de ~/.config/yt-tui/config.
    mkdir -p "$STATE_DIR" 2>/dev/null || die "No se pudo crear $STATE_DIR"
    chmod 700 "$STATE_DIR" 2>/dev/null || true
    : >"$LOG_FILE" 2>/dev/null || true
    chmod 600 "$LOG_FILE" 2>/dev/null || true

trap cleanup EXIT
acquire_lock
take_wakelock

if [[ -z "$url_arg" ]]; then
        usage
        exit 0
    fi
URL=$(extract_url "$url_arg") || die "No encontré ninguna URL en: $url_arg"

# EL ROTULO VA AQUI, y no mas abajo. Todo lo que viene antes es stuff local:
# mkdir, el bloqueo, el wakelock. Todo lo que va despues es ya sea la
# descarga o la API de Termux, y eso puede tardar o colgarse. Si el rotulo
# saliera despues de la primera llamada, un aviso colgado lo dejaria sin
# escribirse nunca, que es exactamente la pantalla en negro que nos toca.
printf 'yt-share %s: descargando\n%s%s%s\n' "$VERSION" "${GRIS}" "$URL" "${R}" >&"$SCREEN_FD"

check_dependencies
    ensure_destination
    build_command

    if ((DRY_RUN)); then
        log_rule
        log_command 'yt-share --dry-run'
        log_rule
        log_line 'Todo correcto. Con --dry-run no se descarga nada.'
        printf '%sTodo correcto.%s No se ha descargado nada.\n' "$VERDE" "$R"
        printf 'Destino: %s\n' "$DOWNLOAD_DIR"
        printf 'Log: %s\n' "$LOG_FILE"
        exit 0
    fi

# Aviso inicial en la PANTALLA, no en la notificacion. La pantalla ya dice
# que arranco y no puede colgarse; la notificacion si, y ademas duplicaba lo
# que se esta viendo. La de notificaciones empieza con el progreso real.
if run_download; then
        end_progress
        # Con --no-overwrites, compartir dos veces el mismo enlace no vuelve a
        # bajar nada y yt-dlp sale con cero igual. Decir "descarga completada"
        # ahi seria mentir, asi que se distingue.
        if grep -q 'has already been downloaded' "$LOG_FILE"; then
            log_line "OK: ya estaba descargado: ${FINAL_FILE:-}"
            # Se escanea tambien en este caso: si el fichero no estaba en la
            # galeria, compartir el enlace otra vez es justo lo que lo mete.
            [[ -n "$FINAL_FILE" ]] && scan_media "$FINAL_FILE" || true
            notify 'yt-share' "Ya estaba: ${FINAL_FILE##*/}"
            printf '%sYa estaba descargado:%s %s\n' "$AMAR" "$R" "${FINAL_FILE:-}"
        elif [[ -n "$FINAL_FILE" ]]; then
            log_line "OK: $FINAL_FILE"
            if scan_media "$FINAL_FILE"; then
                SCANNED=1
            fi
            notify 'yt-share' "Listo: ${FINAL_FILE##*/}"
            printf '%sDescarga completada:%s %s\n' "$VERDE" "$R" "$FINAL_FILE"
            # Se dice en pantalla si la galeria se entero o no. Antes el script
            # lo daba por bueno sin comprobar y el video se quedaba fuera sin
            # que nadie dijera nada, que es peor que no intentarlo.
            if ((!SCANNED)); then
                printf '%sAviso: el video no sale todavia en la galeria.%s\n' "$AMAR" "$R"
                printf '  Sale solo en cuanto Android reindexe. Para forzarlo:\n'
                printf '    content call --uri content://media --method scan_volume --arg external_primary\n'
            fi
        else
            log_line 'yt-dlp termino sin error.'
            # Sin ruta conocida (yt-dlp no la imprimio), se escanea la carpeta
            # entera: es peor que escanear un archivo de mas, pero es lo que
            # hace que el video aparezca sin tener que abrir la terminal.
            scan_media "$DOWNLOAD_DIR" || true
            notify 'yt-share' 'Terminado'
            printf '%sDescarga completada.%s\n' "$VERDE" "$R"
        fi
        exit 0
    fi

    end_progress
    log_line 'ERROR: la descarga fallo.'
    diagnose_failure
    notify_error 'yt-share' "Falló. $HINT"
    printf '%sLa descarga falló.%s %s\n' "$ROJO" "$R" "$HINT" >&2
    printf 'Log: %s\n' "$LOG_FILE" >&2
    ((TTY)) && printf 'Revisa el log o usa yt-share a mano para ver mas detalle.\n' >&2
    exit 1
}

main "$@"