#!/usr/bin/env bash
#
# net-tui - utilidades rápidas de red para Termux.
#
# Diseñado para funcionar donde 'ip' está bloqueado por Android: la IP local
# se detecta con Python, la red local se barre con ping/nmap y la puerta de
# enlace se trata como no-detectable cuando no hay forma de leerla.
# Sin dependencias extra: ping, curl y python3. nmap y termux-api son
# opcionales (nmap se ofrece instalar desde el propio menú).

set -u

SSH_PORT=8022

if [[ -t 1 && -z "${NO_COLOR:-}" ]] && command -v tput >/dev/null 2>&1; then
    B=$(tput bold 2>/dev/null || true)
    R=$(tput sgr0 2>/dev/null || true)
    VERDE=$(tput setaf 2 2>/dev/null || true)
    AMAR=$(tput setaf 3 2>/dev/null || true)
    ROJO=$(tput setaf 1 2>/dev/null || true)
    CIAN=$(tput setaf 6 2>/dev/null || true)
    GRIS=$(tput setaf 8 2>/dev/null || true)
else
    B=""; R=""; VERDE=""; AMAR=""; ROJO=""; CIAN=""; GRIS=""
fi

pause() {
    printf '\nPulsa Enter para continuar...'
    read -r
}

ok() {
    printf '%s%s%s\n' "$VERDE" "$1" "$R"
}

warn_msg() {
    printf '%s%s%s\n' "$AMAR" "$1" "$R"
}

err_msg() {
    printf '%s%s%s\n' "$ROJO" "$1" "$R"
}

title() {
    printf '\n%s%s%s\n' "$B$CIAN" "$1" "$R"
    printf '%s%s%s\n' "$GRIS" '----------------------------------------' "$R"
}

local_ip() {
    local ip
    # Vía principal: socket UDP (no necesita netlink ni root).
    if command -v python3 >/dev/null 2>&1; then
        ip=$(python3 -c 'import socket; s=socket.socket(socket.AF_INET,socket.SOCK_DGRAM); s.connect(("8.8.8.8",80)); print(s.getsockname()[0])' 2>/dev/null || true)
    fi
    if [[ -z "${ip:-}" ]] && command -v termux-wifi-connectioninfo >/dev/null 2>&1; then
        ip=$(termux-wifi-connectioninfo 2>/dev/null | grep -oE '"ip": *"[^"]+"' | head -n 1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' || true)
    fi
    if [[ -z "${ip:-}" ]]; then
        ip=$(hostname 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' | head -n 1 || true)
    fi
    if [[ -z "${ip:-}" ]]; then
        ip=$(ip -o -4 addr show wlan0 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -n 1 || true)
    fi
    if [[ -z "${ip:-}" ]]; then
        ip=$(ip route get 1.1.1.1 2>/dev/null | awk '{for (i = 1; i <= NF; i++) if ($i == "src") { print $(i + 1); exit }}' || true)
    fi
    printf '%s' "${ip:-}"
}

gateway_ip() {
    local gw
    gw=$(ip route show default 2>/dev/null | awk '{for (i = 1; i <= NF; i++) if ($i == "via") { print $(i + 1); exit }}' || true)
    printf '%s' "${gw:-}"
}

assumed_gateway() {
    local ip base
    ip=$(local_ip)
    [[ -n "$ip" ]] || return 1
    base="${ip%.*}"
    printf '%s.1' "$base"
}

dns_servers() {
    local dns=""
    if command -v getprop >/dev/null 2>&1; then
        dns=$(getprop 2>/dev/null | grep -oE 'net\.dns[0-9]+\]: \[[^]]+\]' | grep -oE '\[[^]]+\]' | tr -d '[]' | paste -sd' ' - || true)
    fi
    if [[ -z "$dns" && -f /etc/resolv.conf ]]; then
        dns=$(awk '$1 == "nameserver" {print $2}' /etc/resolv.conf | paste -sd' ' - || true)
    fi
    printf '%s' "${dns:-}"
}

public_ip() {
    local ip
    ip=$(curl -fsSL --max-time 8 https://api.ipify.org 2>/dev/null || true)
    printf '%s' "${ip:-}"
}

show_summary() {
    local ip gw dns pub
    ip=$(local_ip)
    gw=$(gateway_ip)
    dns=$(dns_servers)
    pub=$(public_ip)
    title 'Resumen de red'
    if [[ -n "$ip" ]]; then
        printf 'IP local:    %s%s%s\n' "$VERDE" "$ip" "$R"
    else
        printf 'IP local:    %sno detectada%s\n' "$ROJO" "$R"
    fi
    if [[ -n "$gw" ]]; then
        printf 'Puerta:      %s%s%s\n' "$VERDE" "$gw" "$R"
    else
        printf 'Puerta:      %sno detectable automáticamente%s\n' "$AMAR" "$R"
    fi
    if [[ -n "$dns" ]]; then
        printf 'DNS:         %s%s%s\n' "$VERDE" "$dns" "$R"
    else
        printf 'DNS:         %sno detectados%s\n' "$AMAR" "$R"
    fi
    if [[ -n "$pub" ]]; then
        printf 'IP pública:  %s%s%s\n' "$VERDE" "$pub" "$R"
    else
        printf 'IP pública:  %sno detectada (¿sin internet?)%s\n' "$AMAR" "$R"
    fi
    if command -v termux-wifi-connectioninfo >/dev/null 2>&1; then
        printf '\nWi-Fi (termux-api):\n'
        termux-wifi-connectioninfo 2>/dev/null || warn_msg 'No se pudo leer la info Wi-Fi.'
    fi
}

ping_host() {
    local host="$1" count="${2:-4}"
    printf '\nPing a %s%s%s (%s paquetes):\n' "$B" "$host" "$R" "$count"
    if ping -c "$count" -W 2 "$host"; then
        ok "OK: $host responde."
    else
        err_msg "Fallo: $host no responde."
    fi
}

quick_ping() {
    local gw assumed
    gw=$(gateway_ip)
    if [[ -n "$gw" ]]; then
        ping_host "$gw" 3
    else
        assumed=$(assumed_gateway || true)
        if [[ -n "$assumed" ]]; then
            warn_msg "Puerta no detectable; probando supuesto $assumed ..."
            ping_host "$assumed" 2
        else
            warn_msg 'Puerta de enlace no detectada, se omite.'
        fi
    fi
    ping_host "1.1.1.1" 3
    ping_host "google.com" 3
}

custom_ping() {
    local host
    printf '\nHost o IP a probar (vacío para cancelar): '
    read -r host
    [[ -z "$host" ]] && return 0
    ping_host "$host" 4
}

ensure_nmap() {
    local answer
    command -v nmap >/dev/null 2>&1 && return 0
    warn_msg 'nmap no está instalado.'
    printf '¿Instalarlo ahora? [s/N] '
    read -r answer
    if [[ ! "$answer" =~ ^[sS]$ ]]; then
        return 1
    fi
    if ! command -v pkg >/dev/null 2>&1; then
        err_msg 'Sin pkg no puedo instalarlo. Ejecuta: pkg install nmap'
        return 1
    fi
    if pkg install -y nmap; then
        ok 'nmap instalado.'
        return 0
    fi
    err_msg 'No se pudo instalar nmap.'
    return 1
}

lan_neighbors() {
    local found=0
    title 'Equipos conocidos en la red local'
    if [[ -r /proc/net/arp ]] && [[ -s /proc/net/arp ]]; then
        if awk 'NR > 1 && $3 != "00:00:00:00:00:00" {print $1"  "$3"  "$6}' /proc/net/arp | head -n 40 | grep -q .; then
            awk 'NR > 1 && $3 != "00:00:00:00:00:00" {print $1"  "$3"  "$6}' /proc/net/arp | head -n 40
            found=1
        fi
    fi
    if ((found == 0)) && ip neigh show 2>/dev/null | grep -v FAILED | grep -q .; then
        ip neigh show 2>/dev/null | grep -v FAILED | head -n 40
        found=1
    fi
    if ((found == 0)); then
        warn_msg 'No hay tabla ARP legible en este teléfono (Android lo bloquea).'
        printf 'Usa la opción 5 (barrido) o nmap para descubrir equipos.\n'
    fi
    if ! command -v nmap >/dev/null 2>&1; then
        printf '\n%stip:%s nmap da escaneos más completos.\n' "$GRIS" "$R"
        ensure_nmap || true
    fi
}

lan_sweep() {
    local ip base i
    ip=$(local_ip)
    if [[ -z "$ip" ]]; then
        err_msg 'Sin IP local no se puede derivar la subred.'
        return 0
    fi
    base="${ip%.*}"
    warn_msg "Barriendo $base.1-254 (asume máscara /24, ~30 s)..."
    for i in $(seq 1 254); do
        ping -c 1 -W 1 "$base.$i" >/dev/null 2>&1 &
        if ((i % 32 == 0)); then
            wait
        fi
    done
    wait
    ok 'Barrido terminado.'
    lan_neighbors
}

send_wol() {
    local mac
    printf '\nMAC destino (formato AA:BB:CC:DD:EE:FF, vacío para cancelar): '
    read -r mac
    [[ -z "$mac" ]] && return 0
    if [[ ! "$mac" =~ ^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$ ]]; then
        err_msg 'MAC no válida. No se envió nada.'
        return 0
    fi
    if ! command -v python3 >/dev/null 2>&1; then
        err_msg 'Necesitas python3 para enviar Wake-on-LAN.'
        return 0
    fi
    if python3 -c 'import socket,sys; m=sys.argv[1].replace(":",""); b=bytes.fromhex("ff"*6+m*16); s=socket.socket(socket.AF_INET,socket.SOCK_DGRAM); s.setsockopt(socket.SOL_SOCKET,socket.SO_BROADCAST,1); s.sendto(b,("255.255.255.255",9))' "$mac"; then
        ok "Paquete mágico enviado a $mac (sin guardar la MAC)."
    else
        err_msg 'No se pudo enviar el paquete.'
    fi
}

ssh_status() {
    local user ip
    user=$(whoami 2>/dev/null || printf '%s' "${USER:-usuario}")
    ip=$(local_ip)
    title 'Estado SSH'
    if pgrep -x sshd >/dev/null 2>&1; then
        ok "Servidor: ACTIVO (puerto $SSH_PORT)"
    else
        warn_msg 'Servidor: detenido (se gestiona con termux-ssh)'
    fi
    printf 'Comando desde el PC:\n  %sssh -p %s %s@%s%s\n' "$VERDE" "$SSH_PORT" "$user" "${ip:-IP}" "$R"
}

diagnose() {
    title 'Diagnóstico'
    printf 'DNS configurados: %s%s%s\n' "$VERDE" "$(dns_servers)" "$R"
    if getent hosts google.com >/dev/null 2>&1; then
        ok 'Resolución DNS: OK (google.com resuelve)'
    else
        err_msg 'Resolución DNS: FALLO'
    fi
    if curl -fsSL --max-time 8 -o /dev/null https://www.google.com 2>/dev/null; then
        ok 'Salida HTTPS: OK'
    else
        err_msg 'Salida HTTPS: FALLO'
    fi
    ping_host "1.1.1.1" 3
}

main_menu() {
    local choice
    while true; do
        printf '\n%s%s%s\n' "$B$CIAN" 'net-tui — utilidades de red' "$R"
        printf '%s%s%s\n\n' "$GRIS" '============================' "$R"
        printf '%s1)%s Ver resumen de red\n' "$VERDE" "$R"
        printf '%s2)%s Ping rápido (puerta, 1.1.1.1, google)\n' "$VERDE" "$R"
        printf '%s3)%s Ping a un host personalizado\n' "$VERDE" "$R"
        printf '%s4)%s Ver equipos en la red local\n' "$VERDE" "$R"
        printf '%s5)%s Barrido rápido de la red local\n' "$VERDE" "$R"
        printf '%s6)%s Enviar Wake-on-LAN (MAC escrita al momento)\n' "$VERDE" "$R"
        printf '%s7)%s Estado SSH y datos de conexión\n' "$VERDE" "$R"
        printf '%s8)%s Diagnóstico (DNS + internet + latencia)\n' "$VERDE" "$R"
        printf '%sq)%s Salir\n\n' "$VERDE" "$R"

        read -r -p 'Elige una opción: ' choice
        case "$choice" in
            1) show_summary; pause ;;
            2) quick_ping; pause ;;
            3) custom_ping; pause ;;
            4) lan_neighbors; pause ;;
            5) lan_sweep; pause ;;
            6) send_wol; pause ;;
            7) ssh_status; pause ;;
            8) diagnose; pause ;;
            q|Q) printf 'Hasta luego.\n'; return 0 ;;
            *) warn_msg 'Opción no válida.'; sleep 1 ;;
        esac
    done
}

main_menu
