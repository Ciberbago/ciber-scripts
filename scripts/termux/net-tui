#!/usr/bin/env bash
#
# net-tui - utilidades rápidas de red para Termux.
#
# Sin dependencias extra: usa ip, ping, curl y python3 (para Wake-on-LAN).
# nmap y termux-api son opcionales y solo se usan si ya están instalados.

set -u

SSH_PORT=8022

pause() {
    printf '\nPulsa Enter para continuar...'
    read -r
}

local_ip() {
    local ip
    ip=$(ip -o -4 addr show wlan0 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -n 1)
    if [[ -z "$ip" ]]; then
        ip=$(ip route get 1.1.1.1 2>/dev/null | awk '{for (i = 1; i <= NF; i++) if ($i == "src") { print $(i + 1); exit }}')
    fi
    if [[ -z "$ip" ]]; then
        ip=$(hostname -I 2>/dev/null | awk '{print $1}')
    fi
    printf '%s' "${ip:-no detectada}"
}

gateway_ip() {
    local gw
    gw=$(ip route show default 2>/dev/null | awk '{for (i = 1; i <= NF; i++) if ($i == "via") { print $(i + 1); exit }}')
    printf '%s' "${gw:-no detectada}"
}

dns_servers() {
    local dns=""
    if command -v getprop >/dev/null 2>&1; then
        dns=$(getprop 2>/dev/null | grep -oE 'net\.dns[0-9]+\]: \[[^]]+\]' | grep -oE '\[[^]]+\]' | tr -d '[]' | paste -sd' ' - || true)
    fi
    if [[ -z "$dns" && -f /etc/resolv.conf ]]; then
        dns=$(awk '$1 == "nameserver" {print $2}' /etc/resolv.conf | paste -sd' ' - || true)
    fi
    printf '%s' "${dns:-no detectados}"
}

public_ip() {
    local ip
    ip=$(curl -fsSL --max-time 8 https://api.ipify.org 2>/dev/null || true)
    printf '%s' "${ip:-no detectada (sin internet?)}"
}

show_summary() {
    printf '\nResumen de red\n'
    printf '--------------\n'
    printf 'IP local:    %s\n' "$(local_ip)"
    printf 'Puerta:      %s\n' "$(gateway_ip)"
    printf 'DNS:         %s\n' "$(dns_servers)"
    printf 'IP pública:  %s\n' "$(public_ip)"
    if command -v termux-wifi-connectioninfo >/dev/null 2>&1; then
        printf '\nWi-Fi (termux-api):\n'
        termux-wifi-connectioninfo 2>/dev/null || printf 'No se pudo leer la info Wi-Fi.\n'
    fi
}

ping_host() {
    local host="$1" count="${2:-4}"
    printf '\nPing a %s (%s paquetes):\n' "$host" "$count"
    if ping -c "$count" -W 2 "$host"; then
        printf 'OK: %s responde.\n' "$host"
    else
        printf 'Fallo: %s no responde.\n' "$host"
    fi
}

quick_ping() {
    local gw
    gw=$(gateway_ip)
    if [[ "$gw" != "no detectada" ]]; then
        ping_host "$gw" 3
    else
        printf 'Puerta de enlace no detectada, se omite.\n'
    fi
    ping_host "1.1.1.1" 3
    ping_host "google.com" 3
}

custom_ping() {
    local host
    printf '\nHost o IP a probar (vacío para cancelar): '
    read -r host
    [[ -z "$host" ]] && return 0
    ping_host "$host" 4
}

lan_neighbors() {
    printf '\nEquipos conocidos (tabla ARP/vecinos):\n'
    if ip neigh show 2>/dev/null | grep -v FAILED | head -n 40; then
        :
    else
        printf 'No se pudo leer la tabla de vecinos.\n'
    fi
    if command -v nmap >/dev/null 2>&1; then
        printf '\nnmap está instalado: puedes escanear con nmap -sn <tu-red>/24\n'
    else
        printf '\nTip: instala nmap (pkg install nmap) para escaneos más completos.\n'
    fi
}

lan_sweep() {
    local cidr base i
    cidr=$(ip -o -f inet addr show wlan0 2>/dev/null | awk '{print $4}' | head -n 1)
    if [[ -z "$cidr" ]]; then
        cidr=$(ip -o -f inet addr show 2>/dev/null | awk '$3 == "inet" && $4 !~ /^127\./ {print $4; exit}')
    fi
    if [[ -z "$cidr" ]]; then
        printf 'No se detectó la subred local.\n'
        return 0
    fi
    base="${cidr%.*}"
    printf '\nBarriendo %s.1-254 (puede tardar ~30 s)...\n' "$base"
    for i in $(seq 1 254); do
        ping -c 1 -W 1 "$base.$i" >/dev/null 2>&1 &
        if ((i % 32 == 0)); then
            wait
        fi
    done
    wait
    printf '\nBarrido terminado. Vecinos ahora:\n'
    ip neigh show 2>/dev/null | grep -v FAILED | head -n 40 || true
}

send_wol() {
    local mac
    printf '\nMAC destino (formato AA:BB:CC:DD:EE:FF, vacío para cancelar): '
    read -r mac
    [[ -z "$mac" ]] && return 0
    if [[ ! "$mac" =~ ^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$ ]]; then
        printf 'MAC no válida. No se envió nada.\n'
        return 0
    fi
    if ! command -v python3 >/dev/null 2>&1; then
        printf 'Necesitas python3 para enviar Wake-on-LAN.\n'
        return 0
    fi
    if python3 -c 'import socket,sys; m=sys.argv[1].replace(":",""); b=bytes.fromhex("ff"*6+m*16); s=socket.socket(socket.AF_INET,socket.SOCK_DGRAM); s.setsockopt(socket.SOL_SOCKET,socket.SO_BROADCAST,1); s.sendto(b,("255.255.255.255",9))' "$mac"; then
        printf 'Paquete mágico enviado a %s (sin guardar la MAC).\n' "$mac"
    else
        printf 'No se pudo enviar el paquete.\n'
    fi
}

ssh_status() {
    local user ip
    user=$(whoami 2>/dev/null || printf '%s' "${USER:-usuario}")
    ip=$(local_ip)
    printf '\nEstado SSH\n'
    printf '----------\n'
    if pgrep -x sshd >/dev/null 2>&1; then
        printf 'Servidor: ACTIVO (puerto %s)\n' "$SSH_PORT"
    else
        printf 'Servidor: detenido (se gestiona con termux-ssh)\n'
    fi
    printf 'Comando desde el PC:\n  ssh -p %s %s@%s\n' "$SSH_PORT" "$user" "$ip"
}

diagnose() {
    printf '\nDiagnóstico\n'
    printf '-----------\n'
    printf 'DNS configurados: %s\n' "$(dns_servers)"
    if getent hosts google.com >/dev/null 2>&1; then
        printf 'Resolución DNS: OK (google.com resuelve)\n'
    else
        printf 'Resolución DNS: FALLO\n'
    fi
    if curl -fsSL --max-time 8 -o /dev/null https://www.google.com 2>/dev/null; then
        printf 'Salida HTTPS: OK\n'
    else
        printf 'Salida HTTPS: FALLO\n'
    fi
    ping_host "1.1.1.1" 3
}

main_menu() {
    local choice
    while true; do
        printf '\nnet-tui — utilidades de red\n'
        printf '============================\n\n'
        printf '1) Ver resumen de red\n'
        printf '2) Ping rápido (puerta, 1.1.1.1, google)\n'
        printf '3) Ping a un host personalizado\n'
        printf '4) Ver equipos en la red local\n'
        printf '5) Barrido rápido de la red local\n'
        printf '6) Enviar Wake-on-LAN (MAC escrita al momento)\n'
        printf '7) Estado SSH y datos de conexión\n'
        printf '8) Diagnóstico (DNS + internet + latencia)\n'
        printf 'q) Salir\n\n'

        read -r -p 'Elige una opción: ' choice
        case "$choice" in
            1) show_summary; pause ;;
            2) quick_ping; pause ;;
            3) custom_ping; pause ;;
            4) lan_neighbors; pause ;;
            5) lan_sweep; pause ;;
            6) send_wol; pause ;;
            7) ssh_status; pause ;;
            8) diagnose; pause ;;
            q|Q) printf 'Hasta luego.\n'; return 0 ;;
            *) printf 'Opción no válida.\n'; sleep 1 ;;
        esac
    done
}

main_menu
