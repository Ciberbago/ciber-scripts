#!/usr/bin/env bash

# Gestor sencillo de SSH para Termux.

set -u

SSH_PORT=8022
HOME_DIR="${HOME:?No se pudo detectar HOME}"

if [[ -t 1 && -z "${NO_COLOR:-}" ]] && command -v tput >/dev/null 2>&1; then
    B=$(tput bold 2>/dev/null || true)
    R=$(tput sgr0 2>/dev/null || true)
    VERDE=$(tput setaf 2 2>/dev/null || true)
    AMAR=$(tput setaf 3 2>/dev/null || true)
    ROJO=$(tput setaf 1 2>/dev/null || true)
    CIAN=$(tput setaf 6 2>/dev/null || true)
    GRIS=$(tput setaf 8 2>/dev/null || true)
else
    B=""; R=""; VERDE=""; AMAR=""; ROJO=""; CIAN=""; GRIS=""
fi

is_installed() {
    command -v "$1" >/dev/null 2>&1
}

pause() {
    printf '\nPulsa Enter para continuar...'
    read -r
}

ensure_openssh() {
    if is_installed sshd; then
        return 0
    fi

    if ! is_installed pkg; then
        printf '%sEste script debe ejecutarse dentro de Termux.%s\n' "$ROJO" "$R" >&2
        return 1
    fi

    printf '%sOpenSSH no está instalado. Instalándolo...%s\n' "$AMAR" "$R"
    pkg update -y && pkg install -y openssh
}

get_ip() {
    local ip
    ip=$(ip -o -4 addr show wlan0 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -n 1)
    if [[ -z "$ip" ]]; then
        ip=$(ip route get 1.1.1.1 2>/dev/null | awk '{for (i = 1; i <= NF; i++) if ($i == "src") { print $(i + 1); exit }}')
    fi
    printf '%s' "${ip:-IP_NO_DETECTADA}"
}

get_user() {
    whoami 2>/dev/null || printf '%s' "${USER:-usuario}"
}

server_running() {
    pgrep -x sshd >/dev/null 2>&1
}

show_connection() {
    local user ip
    user=$(get_user)
    ip=$(get_ip)

    printf '\n%s%s%s\n' "$B$CIAN" 'Datos de conexión' "$R"
    printf '%s%s%s\n' "$GRIS" '-----------------' "$R"
    printf 'Usuario: %s%s%s\n' "$VERDE" "$user" "$R"
    printf 'IP:      %s%s%s\n' "$VERDE" "$ip" "$R"
    printf 'Puerto:  %s%s%s\n' "$VERDE" "$SSH_PORT" "$R"
    printf '\nConectarte desde el PC:\n\n'
    printf '  %sssh -p %s %s@%s%s\n' "$VERDE" "$SSH_PORT" "$user" "$ip" "$R"
    printf '\nCopiar un vídeo al teléfono:\n\n'
    printf '  %sscp -P %s video.mp4 %s@%s:~/storage/downloads/%s\n' "$VERDE" "$SSH_PORT" "$user" "$ip" "$R"
    printf '\nEjecutar ffm-tui remotamente:\n\n'
    printf "  %sssh -t -p %s %s@%s '~/bin/ffm-tui'%s\n" "$VERDE" "$SSH_PORT" "$user" "$ip" "$R"
}

start_server() {
    ensure_openssh || return 1

    if server_running; then
        printf '%sEl servidor SSH ya está ejecutándose.%s\n' "$AMAR" "$R"
        show_connection
        return 0
    fi

    if sshd -p "$SSH_PORT"; then
        printf '%sServidor SSH iniciado en el puerto %s.%s\n' "$VERDE" "$SSH_PORT" "$R"
        show_connection
    else
        printf '%sNo se pudo iniciar el servidor SSH.%s\n' "$ROJO" "$R" >&2
        return 1
    fi
}

stop_server() {
    if server_running; then
        pkill -x sshd
        printf '%sServidor SSH detenido.%s\n' "$AMAR" "$R"
    else
        printf '%sEl servidor SSH no está ejecutándose.%s\n' "$AMAR" "$R"
    fi
}

configure_password() {
    ensure_openssh || return 1
    printf 'Configura la contraseña que usarás desde el PC.\n'
    passwd
}

toggle_wake_lock() {
    if is_installed termux-wake-lock; then
        termux-wake-lock
        printf '%sBloqueo de suspensión activado.%s\n' "$VERDE" "$R"
        printf 'Para liberarlo, usa la opción 6 o ejecuta termux-wake-unlock.\n'
    else
        printf '%stermux-wake-lock no está disponible en esta instalación.%s\n' "$AMAR" "$R"
        printf 'Puedes continuar sin él; Android podría suspender Termux.\n'
    fi
}

release_wake_lock() {
    if is_installed termux-wake-unlock; then
        termux-wake-unlock
        printf '%sBloqueo de suspensión liberado.%s\n' "$VERDE" "$R"
    else
        printf '%stermux-wake-unlock no está disponible.%s\n' "$AMAR" "$R"
    fi
}

main_menu() {
    local choice
    while true; do
        clear 2>/dev/null || true
        printf '%s%s%s\n' "$B$CIAN" 'Termux SSH' "$R"
        printf '%s%s%s\n\n' "$GRIS" '==========' "$R"
        if server_running; then
            printf '%sEstado: ACTIVO (puerto %s)%s\n\n' "$VERDE" "$SSH_PORT" "$R"
        else
            printf '%sEstado: detenido%s\n\n' "$AMAR" "$R"
        fi
        printf '%s1)%s Instalar/configurar OpenSSH\n' "$VERDE" "$R"
        printf '%s2)%s Configurar o cambiar contraseña\n' "$VERDE" "$R"
        printf '%s3)%s Iniciar servidor SSH\n' "$VERDE" "$R"
        printf '%s4)%s Detener servidor SSH\n' "$VERDE" "$R"
        printf '%s5)%s Mostrar datos de conexión\n' "$VERDE" "$R"
        printf '%s6)%s Activar bloqueo de suspensión\n' "$VERDE" "$R"
        printf '%s7)%s Liberar bloqueo de suspensión\n' "$VERDE" "$R"
        printf '%sq)%s Salir\n\n' "$VERDE" "$R"

        read -r -p 'Elige una opción: ' choice
        case "$choice" in
            1) ensure_openssh; pause ;;
            2) configure_password; pause ;;
            3) start_server; pause ;;
            4) stop_server; pause ;;
            5) show_connection; pause ;;
            6) toggle_wake_lock; pause ;;
            7) release_wake_lock; pause ;;
            q|Q) printf 'Hasta luego.\n'; return 0 ;;
            *) printf '%sOpción no válida.%s\n' "$AMAR" "$R"; sleep 1 ;;
        esac
    done
}

main_menu
