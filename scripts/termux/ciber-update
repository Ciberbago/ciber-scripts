#!/usr/bin/env bash

# Actualiza únicamente los scripts de Termux desde GitHub, sin clonar el repo.

set -u

VERSION="2026.09.11-1"

BASE_URL="https://raw.githubusercontent.com/Ciberbago/ciber-scripts/main"
MANIFEST_URL="$BASE_URL/scripts/termux/manifest"
PACKAGES_URL="$BASE_URL/scripts/termux/packages"
BIN_DIR="$HOME/bin"
TEMP_DIR=""
AUTO_YES=0
CHECK_ONLY=0
# Anti-caché del CDN de GitHub: cada corrida pide URLs distintas.
# Pon CIBER_CACHE_BUST=0 para desactivarlo (útil en pruebas locales).
CACHE_BUST="${CIBER_CACHE_BUST:-1}"
CACHE_Q=""
if ((CACHE_BUST)); then
    CACHE_Q="?t=$(date +%s)"
fi
if [[ -t 1 && -z "${NO_COLOR:-}" ]] && command -v tput >/dev/null 2>&1; then
    B=$(tput bold 2>/dev/null || true)
    R=$(tput sgr0 2>/dev/null || true)
    VERDE=$(tput setaf 2 2>/dev/null || true)
    AMAR=$(tput setaf 3 2>/dev/null || true)
    ROJO=$(tput setaf 1 2>/dev/null || true)
else
    B=""; R=""; VERDE=""; AMAR=""; ROJO=""
fi

cleanup() {
    [[ -n "$TEMP_DIR" && -d "$TEMP_DIR" ]] && rm -rf "$TEMP_DIR"
}
trap cleanup EXIT

die() {
    printf 'Error: %s\n' "$1" >&2
    exit 1
}

# ¿Está cubierto un paquete? Algunos paquetes proveen otro comando:
# openssh -> ssh, python-yt-dlp -> yt-dlp, yt-dlp-ejs -> deno o node,
# fresh-editor -> fresh.
package_covered() {
    case "$1" in
        openssh) command -v ssh >/dev/null 2>&1 ;;
        python-yt-dlp) command -v yt-dlp >/dev/null 2>&1 ;;
        yt-dlp-ejs) command -v deno >/dev/null 2>&1 || command -v node >/dev/null 2>&1 ;;
        fresh-editor) command -v fresh >/dev/null 2>&1 ;;
        *) command -v "$1" >/dev/null 2>&1 ;;
    esac
}

# Instala los paquetes de scripts/termux/packages que falten en el teléfono.
# En modo --check solo informa, no instala.
ensure_packages() {
    local pkg missing=()
    if ! command -v pkg >/dev/null 2>&1; then
        printf '\n%sSin pkg, se omite la revisión de paquetes.%s\n' "$AMAR" "$R"
        return 0
    fi
    if ! curl -fsSL --max-time 15 "$PACKAGES_URL$CACHE_Q" -o "$TEMP_DIR/packages" 2>/dev/null; then
        printf '\n%sNo se pudo descargar la lista de paquetes.%s\n' "$AMAR" "$R"
        return 0
    fi
    while read -r pkg; do
        [[ -z "$pkg" ]] && continue
        package_covered "$pkg" || missing+=("$pkg")
    done < <(grep -vE '^[[:space:]]*(#|$)' "$TEMP_DIR/packages" | awk '{print $1}')

    if ((${#missing[@]} == 0)); then
        printf '\nPaquetes: %stodo instalado%s.\n' "$VERDE" "$R"
        return 0
    fi
    printf '\n%sPaquetes faltantes:%s %s\n' "$B" "$R" "${missing[*]}"
    if ((CHECK_ONLY)); then
        printf 'Modo comprobación: no se instaló ningún paquete.\n'
        return 0
    fi
    if ((AUTO_YES == 0)); then
        read -r -p '¿Instalar estos paquetes? [s/N] ' answer
        [[ "$answer" =~ ^[sS]$ ]] || { printf 'No se instaló ningún paquete.\n'; return 0; }
    fi
    # shellcheck disable=SC2068
    if pkg install -y ${missing[@]}; then
        printf '%sPaquetes instalados.%s\n' "$VERDE" "$R"
    else
        printf '%sNo se pudieron instalar todos los paquetes.%s\n' "$ROJO" "$R" >&2
        return 1
    fi
}

usage() {
    printf '%s\n' \
        'Uso: ciber-update [opción]' \
        '' \
        'Sincroniza scripts y asegura los paquetes de scripts/termux/packages.' \
        '' \
        '  --check    Buscar cambios sin instalar nada' \
        '  --yes      Instalar actualizaciones sin preguntar' \
        '  --version  Mostrar la versión instalada' \
        '  --help     Mostrar esta ayuda'
}

for argument in "$@"; do
    case "$argument" in
        --check) CHECK_ONLY=1 ;;
        --yes) AUTO_YES=1 ;;
        --version|-v) printf 'ciber-update %s\n' "$VERSION"; exit 0 ;;
        --help|-h) usage; exit 0 ;;
        *) printf 'Opción desconocida: %s\n\n' "$argument" >&2; usage; exit 2 ;;
    esac
done

command -v curl >/dev/null 2>&1 || die 'Necesitas curl. Ejecuta: pkg install curl'
command -v sha256sum >/dev/null 2>&1 || die 'Necesitas sha256sum. Ejecuta: pkg install coreutils'

mkdir -p "$BIN_DIR" || die "No se pudo crear $BIN_DIR"

# Oculta el MOTD por defecto de Termux para dejar solo la bienvenida propia.
# No se toca en modo --check para no modificar nada al solo comprobar.
if ((CHECK_ONLY == 0)); then
    touch "$HOME/.hushlogin" 2>/dev/null || \
        printf 'Aviso: no se pudo crear ~/.hushlogin.\n' >&2
fi

TEMP_DIR=$(mktemp -d "${TMPDIR:-/tmp}/ciber-update.XXXXXX") || die 'No se pudo crear un directorio temporal.'

printf 'Descargando manifiesto...\n'
curl -fsSL "$MANIFEST_URL$CACHE_Q" -o "$TEMP_DIR/manifest" || \
    die 'No se pudo descargar el manifiesto desde GitHub.'

changed=()
while IFS='|' read -r name remote_path mode target; do
    [[ -z "${name:-}" || "$name" == \#* ]] && continue
    [[ -n "${remote_path:-}" && -n "${mode:-}" && -n "${target:-}" ]] || continue

    remote_url="$BASE_URL/$remote_path$CACHE_Q"
    downloaded="$TEMP_DIR/$name"
    destination="$HOME/$target"

    printf '%sComprobando %-18s%s ' "$B" "$name" "$R"
    if ! curl -fsSL "$remote_url" -o "$downloaded"; then
        printf '%sERROR%s\n' "$ROJO" "$R"
        printf '  No se pudo descargar %s\n' "$remote_url" >&2
        continue
    fi

    chmod "$mode" "$downloaded"
    remote_hash=$(sha256sum "$downloaded" | cut -d' ' -f1)
    if [[ -f "$destination" ]]; then
        local_hash=$(sha256sum "$destination" | cut -d' ' -f1)
    else
        local_hash=''
    fi

    if [[ "$remote_hash" == "$local_hash" ]]; then
        printf '%ssin cambios%s\n' "$VERDE" "$R"
    else
        if [[ -f "$destination" ]]; then
            printf '%sactualización disponible%s\n' "$AMAR" "$R"
        else
            printf '%snuevo%s\n' "$VERDE" "$R"
        fi
        changed+=("$name")
    fi
done < "$TEMP_DIR/manifest"

if ((${#changed[@]} == 0)); then
    printf '\nArchivos: %stodo actualizado%s.\n' "$VERDE" "$R"
else
    printf '\n%sCambios disponibles:%s\n' "$B" "$R"
    printf '  %s\n' "${changed[@]}"

    if ((CHECK_ONLY)); then
        printf '\nModo comprobación: no se instaló ningún archivo.\n'
    else
        if ((AUTO_YES == 0)); then
            read -r -p $'¿Instalar estos cambios? [s/N] ' answer
            [[ "$answer" =~ ^[sS]$ ]] || printf 'No se instaló ningún archivo.\n'
        fi
        if ((AUTO_YES == 1)) || [[ "${answer:-}" =~ ^[sS]$ ]]; then
            for name in "${changed[@]}"; do
                IFS='|' read -r manifest_name remote_path mode target < <(grep -F "${name}|" "$TEMP_DIR/manifest")
                destination="$HOME/$target"
                mkdir -p "$(dirname "$destination")" || die "No se pudo crear el destino de $name"
                install -m "$mode" "$TEMP_DIR/$name" "$destination" || \
                    die "No se pudo instalar $name"
                printf '%sInstalado: %s%s\n' "$VERDE" "$destination" "$R"
            done
        fi
    fi
fi

ensure_packages

printf '\nActualización completada.\n'
