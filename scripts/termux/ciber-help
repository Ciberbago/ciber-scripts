#!/usr/bin/env bash

# Ayuda de los scripts personales de Termux.

set -u

FILTER="${1:-}"
FOUND=0
if [[ -t 1 && -z "${NO_COLOR:-}" ]] && command -v tput >/dev/null 2>&1; then
    B=$(tput bold 2>/dev/null || true)
    R=$(tput sgr0 2>/dev/null || true)
    CIAN=$(tput setaf 6 2>/dev/null || true)
    VERDE=$(tput setaf 2 2>/dev/null || true)
    GRIS=$(tput setaf 8 2>/dev/null || true)
else
    B=""; R=""; CIAN=""; VERDE=""; GRIS=""
fi

matches() {
    if [[ -z "$FILTER" ]]; then
        return 0
    fi
    if printf '%s %s\n' "$1" "$2" | grep -Fqi -- "$FILTER"; then
        FOUND=1
        return 0
    fi
    return 1
}

section() {
    printf '\n%s%s%s\n' "$B$CIAN" "$1" "$R"
    printf '%s%s%s\n' "$GRIS" '----------------------------------------' "$R"
}

item() {
    local command="$1" description="$2"
    matches "$command" "$description" || return 0
    printf '\n%s%s%s\n' "$B$VERDE" "$command" "$R"
    printf '  %s\n' "$description"
}

printf '\n%s%s%s\n' "$B$CIAN" 'CIBER-SCRIPTS PARA TERMUX' "$R"
printf '=========================\n'
if [[ -n "$FILTER" ]]; then
    printf 'Filtro: %s\n' "$FILTER"
fi

section 'ACTUALIZACIÓN Y AYUDA'
item 'ciber-help' \
    'Muestra esta ayuda. Usa ciber-help ffm, ciber-help yt o ciber-help ssh para filtrar.'
item 'ciber-update' \
    'Busca y descarga solo los scripts modificados desde GitHub, sin clonar el repositorio.'
item 'ciber-update --check' \
    'Comprueba si hay actualizaciones sin instalar nada.'
item 'ciber-update --yes' \
    'Instala todas las actualizaciones sin pedir confirmación.'

section 'FFMPEG'
item 'ffm-tui' \
    'TUI para vídeos. Sin argumentos busca vídeos en la carpeta actual y en ~/storage/downloads.'
item 'ffm-tui video.mp4' \
    'Abre directamente un vídeo concreto.'
item 'ffm-tui /ruta/video.mp4' \
    'Permite comprimir con el preset personal, cambiar audio o copiar sin recodificar.'

section 'YT-DLP'
item 'yt-tui' \
    'TUI para descargar vídeo o audio; guarda por defecto en ~/storage/downloads.'
item "yt-tui 'URL'" \
    'Abre directamente la URL y después permite elegir formato y calidad.'
item '~/.config/yt-tui/config' \
    'Configuración opcional para cookies, pausas, headers, tokens o API keys.'

section 'SSH'
item 'termux-ssh' \
    'Instala, configura, inicia y detiene el servidor SSH de Termux en el puerto 8022.'
item 'ssh -p 8022 USUARIO@IP' \
    'Comando para conectarte al teléfono desde el PC después de iniciar termux-ssh.'
item 'scp -P 8022 archivo USUARIO@IP:~/storage/downloads/' \
    'Copia archivos del PC al almacenamiento compartido del teléfono.'

section 'BOOTSTRAP'
item 'bash <(curl -L url.jaimelopez.top/termux)' \
    'Prepara Termux desde cero: paquetes, almacenamiento, Fish, SSH y scripts personales.'
item '~/.hushlogin' \
    'Oculta el mensaje inicial de Termux para dejar solo la bienvenida de ciber-scripts.'

if [[ -n "$FILTER" ]]; then
    if ((FOUND == 0)); then
        printf '\nNo se encontró el filtro: %s\n' "$FILTER"
        exit 1
    fi
fi

printf '\n'
