#!/data/data/com.termux/files/usr/bin/bash
#
# termux-url-opener - lo que llama Android al compartir un enlace con Termux.
#
# El nombre y la carpeta NO son eleccion nuestra: la app de Termux busca este
# archivo en ~/bin y le pasa la URL como unico argumento. Si no existe, en vez
# de descargar sale un dialogo de error en pantalla.
#
# EL SHEBANG NO ES '#!/usr/bin/env bash' Y NO ES COSA QUE SE ELIJA. Al compartir,
# Termux no ejecuta este archivo desde una shell: lo lanza por un intent y lee
# la primera linea. Si esa linea empieza por /usr, la traduce a su propio env,
# y queda el bucle 'env <este script>', que al volver a leer el shebang busca
# /usr/bin/env, no lo encuentra porque en Android no existe, y muere con un
# error de 'no such file or directory' y codigo 127. Ver setupShellCommandArguments
# en TermuxShellUtils.java, que es donde se decide esto.
#
# Por eso va la ruta absoluta, que es ademas lo que ya hace bootstrap.sh.
# Tambien existe 'termux-fix-shebang', pero eso modifica el archivo en el
# telefono y se pierde en la siguiente actualizacion.
#
# Este archivo ademas deja constancia de que ha corrido. Cuando la pantalla se
# queda en negro no hay forma de saber si fallo el shim, fallo yt-share, o no
# se ha actualizado el telefono: con la marca se distinguen los tres casos de
# un vistazo, sin depender de que se vea nada.

set -u

SHIM_VERSION="2026.10.09-1"
BREADCRUMB_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/yt-share"
BREADCRUMB="$BREADCRUMB_DIR/compartido.log"

# Escribe en la pantalla y, a la vez, deja la marca en el log. La marca va
# primero: si la escritura en pantalla falla, al menos queda eso.
mkdir -p "$BREADCRUMB_DIR" 2>/dev/null || true
printf '%s shim %s pid %s url %s\n' \
    "$(date '+%Y-%m-%d %H:%M:%S')" "$SHIM_VERSION" "$$" "${1:-NINGUNA}" \
    >>"$BREADCRUMB" 2>/dev/null || true

if [[ -t 1 ]]; then
    SCREEN=1
elif [[ -c /dev/tty ]] && { exec 3>/dev/tty; } 2>/dev/null; then
    SCREEN=3
else
    SCREEN=1
fi

printf 'termux-url-opener %s: %s\n' "$SHIM_VERSION" "${1:-sin URL}" >&"$SCREEN"

if (($# == 0)); then
    printf 'Android me llama con la URL como unico argumento.\n' >&"$SCREEN"
    printf 'A mano se usa: %s URL\n' "$0" >&"$SCREEN"
    exit 2
fi

# yt-share vive al lado. No se busca en el PATH a proposito: si alguien lo
# instala en otro sitio, el nombre del manifest manda, y avisar es mejor que
# dejar un fallo raro en un intent del que no se ve la salida.
if [[ ! -x "$HOME/bin/yt-share" ]]; then
    printf 'Falta ~/bin/yt-share. Se instala con: ciber-update --yes\n' >&"$SCREEN"
    exit 127
fi

exec "$HOME/bin/yt-share" "$@"